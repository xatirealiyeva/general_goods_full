# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=shopdb
POSTGRES_USER=shopuser
POSTGRES_PASSWORD=shoppass
POSTGRES_PORT=5432

# Redis
# REDIS_URL is set automatically by docker-compose to redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin bootstrap account (spec: default admin email)
DEFAULT_ADMIN_EMAIL=xatire777aliyeva@gmail.com

# Frontend
FRONTEND_API_BASE_URL=http://localhost:8000/api
VITE_PAYPAL_CLIENT_ID=sb

# Optional AWS S3 (leave blank to use local media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Optional payment provider keys (payments module simulates success without them)
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
