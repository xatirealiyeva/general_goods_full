# Django / Render backend
DJANGO_SECRET_KEY=generate-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-api.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DATABASE_CONN_MAX_AGE=600
GUNICORN_WORKERS=3
RUN_SEED_DEMO_DATA=false

# PostgreSQL: Render supplies this private connection string.
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis / Render Key Value
REDIS_URL=redis://default:password@host:6379/0

# Vercel frontends allowed to call this API
CORS_ALLOWED_ORIGINS=https://your-shop.vercel.app,https://your-admin.vercel.app

# Admin bootstrap account
DEFAULT_ADMIN_EMAIL=admin@example.com

# Local Docker frontend build only; Vercel configures VITE_API_BASE_URL itself.
FRONTEND_API_BASE_URL=https://your-api.onrender.com/api
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# Optional S3-compatible media storage. Required on Render if uploads must persist.
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=your-region

# Payment provider credentials are not used by the current simulated backend gateway.
STRIPE_SECRET_KEY=not-used-by-current-backend
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=not-used-by-current-backend
